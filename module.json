{
  "id": "oplaits",
  "name": "oPlaits",
  "abbrev": "oPLTS",
  "version": "0.1.0",
  "description": "Plaits macro oscillator (the original DSP, all 24 engines, at the hardware's own rate) played on every 1/16 of Move's transport: 16 trigger pads, touch-recorded knob motion, a Phrase Gen RANDOM pad, preset pads and a PITCH knob set in the scale",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "dsp.so",
  "ui_chain": "ui_chain.js",
  "component_type": "sound_generator",
  "capabilities": {
    "component_type": "sound_generator",
    "chainable": true,
    "audio_in": false,
    "audio_out": true,
    "midi_in": true,
    "midi_out": false,
    "chain_params": [
      {
        "key": "level",
        "name": "Volume",
        "short_name": "VOLUME",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%"
      },
      {
        "key": "engine",
        "name": "Engine",
        "short_name": "ENGINE",
        "type": "enum",
        "options": [
          "VAVCF",
          "PHDIS",
          "6OP1",
          "6OP2",
          "6OP3",
          "WTERR",
          "STRMC",
          "CHIP",
          "VA",
          "WSHAP",
          "FM",
          "GRAIN",
          "ADDIT",
          "WTBL",
          "CHORD",
          "SPEAK",
          "SWARM",
          "NOISE",
          "PARTI",
          "STRNG",
          "MODAL",
          "KICK",
          "SNARE",
          "HIHAT"
        ],
        "default": "VA"
      },
      {
        "key": "harmonics",
        "name": "Harmonics",
        "short_name": "HARMO",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%"
      },
      {
        "key": "timbre",
        "name": "Timbre",
        "short_name": "TIMBRE",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%"
      },
      {
        "key": "morph",
        "name": "Morph",
        "short_name": "MORPH",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5,
        "unit": "%"
      },
      {
